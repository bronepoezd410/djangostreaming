```gitignore
# Python / Django
*.py[cod]
__pycache__/
.Python
venv/
env/
ENV/
.venv/
*.sqlite3
*.db
*.log
local_settings.py
*.env
.env
.env.*
!.env.example
*.egg-info/
dist/
build/

# Python testing and tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node.js / TypeScript / React
node_modules/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo
coverage/
.eslintcache
.parcel-cache/
.cache/
frontend/build/

# Media and static files
media/
staticfiles/
collected_static/

# Database dumps and backups
*.sql
*.sql.gz
*.dump
*.bak
*.backup
mysql-volume-backup.tar.gz

# Browser diagnostics
*.har

# IDE and editor files
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.DS_Store
*.swp
*~

# Temporary files
*.tmp
*.temp
